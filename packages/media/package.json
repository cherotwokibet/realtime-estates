{
  "name": "@realtor/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local experimental synthetic image-byte conversion proof; no upload acceptance boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./local-store": { "types": "./dist/local-store.d.ts", "import": "./dist/local-store.js" },
    "./process-readback": { "types": "./dist/process-readback.d.ts", "import": "./dist/process-readback.js" },
    "./windows-supervisor": { "types": "./dist/windows-supervisor.d.ts", "import": "./dist/windows-supervisor.js" },
    "./coordinator-database": { "types": "./dist/coordinator-database.d.ts", "import": "./dist/coordinator-database.js" },
    "./durable-store": { "types": "./dist/durable-store.d.ts", "import": "./dist/durable-store.js" },
    "./attempt-journal": { "types": "./dist/attempt-journal.d.ts", "import": "./dist/attempt-journal.js" },
    "./worker-admission": { "types": "./dist/worker-admission.d.ts", "import": "./dist/worker-admission.js" },
    "./processing-request": { "types": "./dist/processing-request.d.ts", "import": "./dist/processing-request.js" },
    "./one-attempt": { "types": "./dist/one-attempt.d.ts", "import": "./dist/one-attempt.js" },
    "./upload-request": { "types": "./dist/upload-request.d.ts", "import": "./dist/upload-request.js" },
    "./upload-body": { "types": "./dist/upload-body.d.ts", "import": "./dist/upload-body.js" }
  },
  "files": ["dist", "runtime"],
  "engines": { "node": ">=24.3.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": { "sharp": "0.35.5" }
}
