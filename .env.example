# Local example only; no production credentials here.
APP_ENV=development
TENANT_SLUG=realtime-estates
# Optional unified public deployment manifest; documented schema in docs/tenant-manifest.md.
# Keep this synthetic example local. Production company facts require owner approval.
# TENANT_MANIFEST_JSON=<bounded server-only JSON; see docs/tenant-manifest.md>
API_MODE=demo
WEB_CATALOGUE_MODE=demo
# Explicit server-side connected public catalogue; see docs/connected-catalogue.md.
# WEB_CATALOGUE_MODE=connected
# API_ORIGIN=https://controlled-company-api.example
# WEB_CATALOGUE_DATA=synthetic
# WEB_CATALOGUE_SEARCH=public-search-v1 # Connected catalogue-wide search, exact counts and pages.
# ALLOW_LOOPBACK_API=true # Only with a loopback HTTP origin in development/test.
# Optional local database mode requires all server-only values below and a dedicated runtime login.
# DATABASE_URL=postgresql://runtime-login:SERVER-SECRET@controlled-host/database
# AUTH_ISSUER=https://controlled-provider.example/issuer
# AUTH_AUDIENCE=realtor-api
# AUTH_JWKS_URL=https://controlled-provider.example/issuer/jwks
# PRIVACY_NOTICE_VERSION=reviewed-notice-version
# TRUSTED_TENANTS_JSON=[{"tenantId":"11111111-1111-4111-8111-111111111111","slug":"realtime-estates","hostnames":["localhost"]}]
# Provision controlled infrastructure and configure server-only secrets before integration.
# Hosted browser sign-in is default-off. Each web/admin deployment uses a separate client/origin.
# See docs/hosted-browser-identity.md; never put these values in NEXT_PUBLIC variables.
# APP_ENV=staging
# BROWSER_IDENTITY_CONFIG=<server-only exact provider/client/origin/company JSON>
# BROWSER_IDENTITY_DATABASE_URL=postgresql://identity_runtime:SERVER-SECRET@controlled-host/identity?sslmode=verify-full
# BROWSER_IDENTITY_STORAGE_KEY=<independent 32-byte server secret as 64 lowercase hex characters>
# Firebase deployments use this instead of BROWSER_IDENTITY_CONFIG; never configure both providers.
# FIREBASE_BROWSER_CONFIG=<server-only projectId/applicationOrigin/tenantId JSON; docs/google-cloud-firebase.md>
# FIREBASE_WEB_CONFIG=<public SDK apiKey/authDomain/projectId/appId JSON; no server secrets>
# Optional hosted saved homes: requires the separate SQL original-state proposal and a reviewed protected API.
# HOSTED_CUSTOMER_API_ORIGIN=https://controlled-customer-api.example
# Optional hosted admin branch workspace: requires reviewed staff-browser-originals.sql/grants.
# HOSTED_STAFF_API_ORIGIN=https://controlled-staff-api.example
# PRIVACY_NOTICE_VERSION=reviewed-notice-version
# Separate owned API entry: npm run start:hosted --workspace=@realtor/api
# NODE_ENV=production and APP_ENV=staging are required; unset legacy API_MODE and all preview variables.
# GOOGLE_CLOUD_PROJECT=boniface-realtor-staging
# HOSTED_API_CONFIG=<exact realtor-staging-api-v1 policy/projectId/tenantId/applicationOrigin/privacyNoticeVersion JSON>
# HOSTED_API_DATABASE_URL=postgresql://isolated_api_login:SERVER-SECRET@controlled-host/realtor?sslmode=verify-full
# These examples are configuration only, not deployment approval.

# Optional attached-workload Cloud SQL IAM transport; see docs/cloud-sql-iam.md.
# Remove the matching _DATABASE_URL when enabling _CLOUD_SQL_CONFIG; never configure both.
# Requires production/staging, matching GOOGLE_CLOUD_PROJECT and actual Cloud Run K_SERVICE.
# BROWSER_IDENTITY_CLOUD_SQL_CONFIG=<exact instanceConnectionName/database/serviceAccount/ipType JSON>
# HOSTED_API_CLOUD_SQL_CONFIG=<exact instanceConnectionName/database/serviceAccount/ipType JSON>
# Use separate web/admin/API service accounts. No database password or credential-file override.
# BROWSER_IDENTITY_STORAGE_KEY remains an independent server encryption secret.
