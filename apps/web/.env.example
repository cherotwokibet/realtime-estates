# Interactive area map is opt-in. This public URL must never contain a secret.
# OSM Standard tiles are suitable for local/manual evaluation only in this project:
# best-effort availability, visible attribution, normal visible-tile requests only,
# no bulk/offline prefetch. Choose and review a production provider before enabling there.
# NEXT_PUBLIC_AREA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
