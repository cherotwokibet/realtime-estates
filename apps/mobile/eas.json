{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "env": { "NODE_ENV": "development", "TENANT_SLUG": "realtime-estates" }
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "android": { "buildType": "apk" },
      "env": { "TENANT_SLUG": "realtime-estates" }
    },
    "sample-preview": {
      "extends": "preview",
      "env": { "TENANT_SLUG": "sample-homes" }
    }
  }
}
