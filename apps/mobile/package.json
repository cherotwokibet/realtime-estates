{
  "name": "@realtor/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --workspace=@realtor/api && npm run test:compile --workspace=@realtor/web && tsc -p tsconfig.tests.json && node --test --test-concurrency=1 tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@realtor/api-client": "0.1.0",
    "@realtor/demo": "0.1.0",
    "@realtor/domain": "0.1.0",
    "expo": "57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "57.0.3",
    "firebase": "13.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  }
}
